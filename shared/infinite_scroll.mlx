(* Loads [next], the same list with one more page, when the first skeleton card after
   the list (the element with id [skeleton_id]) comes into view.
   The URL keeps the number of pages, so a reload or Back shows them all. *)

let skeleton_id = "next-page"

let[@client] make ~(next : string option) () =
  Yuka.Effect.after ~cleanup:(fun stop -> stop ()) (fun () ->
      match next with
      | Some url -> !Bridge.on_visible skeleton_id (fun () -> Yuka.Browser.navigate ~replace:true ~keep_scroll:true url)
      | None -> fun () -> ());
  <div class_="h-20 flex items-center justify-center">
    (match next with
     | Some _ -> <div class_="animate-spin rounded-full h-8 w-8 border-t-2 border-brand-primary" />
     | None -> Yuka.empty)
  </div>
