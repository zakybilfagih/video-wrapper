(* A titled row of cards that scrolls sideways, with buttons that scroll it. *)

let[@client] make ~(title : string) ~children () =
  Yuka.with_unique_id (fun id ->
      <div class_="space-y-4 py-4">
        <div class_="flex items-center justify-between px-2">
          <h2 class_="text-xl font-display font-semibold tracking-tight text-white">(Yuka.text title)</h2>
          <div class_="flex space-x-2">
            <button type_=`button aria_label="Scroll left" on_click=(fun _ -> !Bridge.scroll_row id (-1))
              class_="p-2 rounded-full bg-white/5 hover:bg-white/10 transition-colors">
              (Icons.chevron_left "w-5 h-5")
            </button>
            <button type_=`button aria_label="Scroll right" on_click=(fun _ -> !Bridge.scroll_row id 1)
              class_="p-2 rounded-full bg-white/5 hover:bg-white/10 transition-colors">
              (Icons.chevron_right "w-5 h-5")
            </button>
          </div>
        </div>
        <div id class_="flex space-x-4 overflow-x-auto no-scrollbar scroll-smooth px-2 pb-4">children</div>
      </div>)
