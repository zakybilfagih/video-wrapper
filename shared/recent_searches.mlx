(* The recent searches, under an empty search field. *)

let[@client] make ~(queries : string list) () =
  <div class_="mt-4 p-6 bg-white/5 border border-white/10 rounded-3xl backdrop-blur-xl animate-[fadeIn_0.3s_ease_both]">
    <div class_="flex items-center justify-between mb-4">
      <div class_="flex items-center space-x-2 text-gray-400">
        (Icons.clock "w-4 h-4")
        <span class_="text-xs font-bold uppercase tracking-widest">"Recent"</span>
      </div>
      <button type_=`button
        on_click=(fun _ -> Saved.Searches.save []; Yuka.Browser.refresh ())
        class_="text-xs font-semibold text-gray-500 hover:text-brand-primary flex items-center space-x-1 transition-colors">
        (Icons.trash "w-3 h-3")
        <span>"Clear"</span>
      </button>
    </div>
    <div class_="grid grid-cols-1 sm:grid-cols-2 gap-2">
      (Yuka.fragment
         (List.map
            (fun query ->
              <div class_="flex items-center justify-between bg-white/5 hover:bg-white/10 rounded-xl group transition-all">
                <a href=(Routes.search ~q:(!Bridge.to_utf8 query) ()) class_="flex-1 p-3 text-gray-300 font-medium text-sm">(Yuka.text query)</a>
                <button type_=`button aria_label=("Remove " ^ query)
                  on_click=(fun _ -> Saved.Searches.remove query; Yuka.Browser.refresh ())
                  class_="p-3 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity">
                  (Icons.x "w-4 h-4 text-gray-500 hover:text-brand-primary")
                </button>
              </div>)
            queries))
    </div>
  </div>
