    "icons": "node scripts/icons.mjs > shared/icons.ml"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "lucide": "^0.546.0",
    "tailwindcss": "^4.1.14"
  }
}
